rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    // Server/admin-controlled authorization source.
    // Clients cannot create, update, or delete these documents.
    function hasVillageAssignment() {
      return isNonAnonymous() &&
        exists(/databases/$(database)/documents/village_assignments/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/village_assignments/$(request.auth.uid)).data.active == true;
    }

    function assignedVillageNo() {
      return get(/databases/$(database)/documents/village_assignments/$(request.auth.uid)).data.villageNo;
    }

    function hasVillageAccess(villageNo) {
      return hasVillageAssignment() &&
        assignedVillageNo() == villageNo;
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      allow create: if isNonAnonymous() &&
        request.auth.uid == uid &&
        hasVillageAssignment() &&
        request.resource.data.villageNo == assignedVillageNo();

      allow update: if isNonAnonymous() &&
        request.auth.uid == uid &&
        hasVillageAssignment() &&
        request.resource.data.villageNo == assignedVillageNo() &&
        resource.data.villageNo == assignedVillageNo();

      allow delete: if false;
    }

    match /households/{householdUuid} {
      allow read: if hasVillageAccess(resource.data.villageNo);
      allow create: if hasVillageAccess(request.resource.data.villageNo);
      allow update: if
        hasVillageAccess(resource.data.villageNo) &&
        hasVillageAccess(request.resource.data.villageNo);
      allow delete: if hasVillageAccess(resource.data.villageNo);
    }

    match /persons/{personUuid} {
      allow read: if hasVillageAccess(resource.data.villageNo);
      allow create: if hasVillageAccess(request.resource.data.villageNo);
      allow update: if
        hasVillageAccess(resource.data.villageNo) &&
        hasVillageAccess(request.resource.data.villageNo);
      allow delete: if hasVillageAccess(resource.data.villageNo);
    }

    match /tombstones/{tombstoneId} {
      allow read: if hasVillageAccess(resource.data.villageNo);
      allow create: if hasVillageAccess(request.resource.data.villageNo);
      allow update: if
        hasVillageAccess(resource.data.villageNo) &&
        hasVillageAccess(request.resource.data.villageNo);
      allow delete: if hasVillageAccess(resource.data.villageNo);
    }

    match /health_screenings/{screeningUuid} {
      allow read: if hasVillageAccess(resource.data.villageNo);
      allow create: if hasVillageAccess(request.resource.data.villageNo);
      allow update: if
        hasVillageAccess(resource.data.villageNo) &&
        hasVillageAccess(request.resource.data.villageNo);
      allow delete: if hasVillageAccess(resource.data.villageNo);
    }

    match /vhv_members/{memberId} {
      allow read: if hasVillageAccess(resource.data.villageNo);
      allow create: if hasVillageAccess(request.resource.data.villageNo);
      allow update: if
        hasVillageAccess(resource.data.villageNo) &&
        hasVillageAccess(request.resource.data.villageNo);
      allow delete: if hasVillageAccess(resource.data.villageNo);
    }

    match /village_assignments/{uid} {
      allow read: if isNonAnonymous() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
