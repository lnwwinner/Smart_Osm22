rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get current user's profile data
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user has access to a specific village
    function hasVillageAccess(villageNo) {
      return isAuthenticated() && getUserProfile().villageNo == villageNo;
    }

    // 1. Users collection
    // Users may create/update their own profile, but villageNo is immutable
    // after creation so a client cannot switch itself into another village.
    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() &&
        request.auth.uid == uid &&
        request.resource.data.villageNo is string;
      allow update: if isAuthenticated() &&
        request.auth.uid == uid &&
        request.resource.data.villageNo == resource.data.villageNo;
      allow delete: if false;
    }

    // 2. Households collection
    match /households/{householdUuid} {
      allow read, write: if isAuthenticated() && 
        (resource == null || hasVillageAccess(resource.data.villageNo)) &&
        (request.resource == null || hasVillageAccess(request.resource.data.villageNo));
    }

    // 3. Persons collection
    match /persons/{personUuid} {
      allow read, write: if isAuthenticated() && 
        (resource == null || hasVillageAccess(resource.data.villageNo)) &&
        (request.resource == null || hasVillageAccess(request.resource.data.villageNo));
    }

    // 4. Tombstones collection
    match /tombstones/{tombstoneId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || hasVillageAccess(resource.data.villageNo)) &&
        (request.resource == null || hasVillageAccess(request.resource.data.villageNo));
    }
    
    // 5. VHV Members collection
    match /health_screenings/{screeningUuid} {
      allow read, write: if isAuthenticated() &&
        (resource == null || hasVillageAccess(resource.data.villageNo)) &&
        (request.resource == null || hasVillageAccess(request.resource.data.villageNo));
    }

    match /vhv_members/{memberId} {
      allow read: if isAuthenticated() && (resource == null || hasVillageAccess(resource.data.villageNo));
      allow write: if isAuthenticated() && (resource == null || hasVillageAccess(resource.data.villageNo)) && (request.resource == null || hasVillageAccess(request.resource.data.villageNo));
    }
  }
}
